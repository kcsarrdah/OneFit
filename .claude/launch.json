{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "web-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "preview",
        "--",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173
    },
    {
      "name": "app-web",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd frontend && CI=1 npx expo start --web --port 8081"
      ],
      "port": 8081
    }
  ]
}